{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Netrunner Panel Setup",
  "version": "1.6.1",
  "identifier": "com.netrunner.panel.instalador",
  "build": {
    "beforeDevCommand": { "script": "npm run instalador:dev", "cwd": "../..", "wait": false },
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": { "script": "npm run instalador:build", "cwd": "../.." },
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "instalador",
        "title": "Netrunner Panel · instalación",
        "width": 640,
        "height": 410,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/128x128@2x.png",
      "../../src-tauri/icons/icon.ico"
    ]
  }
}

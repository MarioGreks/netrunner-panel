{
  "name": "netrunner-panel",
  "private": true,
  "version": "1.8.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "release:preparar": "node scripts/preparar-release.mjs",
    "instalador:construir": "node scripts/construir-instalador.mjs",
    "instalador:dev": "vite --config instalador/vite.config.ts",
    "instalador:build": "tsc && vite build --config instalador/vite.config.ts",
    "instalador:tauri": "cd instalador/src-tauri && tauri"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}

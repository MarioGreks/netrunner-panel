{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tarjeta",
  "description": "Permisos mínimos de las ventanas de tarjeta desacopladas (eventos y barra de título propia)",
  "windows": ["tarjeta-*"],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close"
  ]
}

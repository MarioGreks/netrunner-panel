{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Netrunner Panel",
  "version": "1.6.0",
  "identifier": "com.netrunner.panel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "panel",
        "url": "index.html",
        "title": "Netrunner Panel",
        "width": 420,
        "height": 800,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "tab",
        "url": "tab.html",
        "title": "Netrunner Panel · mini",
        "width": 220,
        "height": 96,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Panel de escritorio estilo cyberpunk HUD",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["Spanish"],
        "customLanguageFiles": { "Spanish": "windows/idioma-es.nsh" },
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/nsis-header.bmp",
        "sidebarImage": "windows/nsis-sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3MzEwOTlEMzQ4MjkyM0UKUldRK2tvSTBuUWt4aHdwdGpvcUFQWHNyTHZsTmtTN2ZSQmhrUE10bmpLMWJLcVM1SkVPaUhTdTkK",
      "endpoints": ["https://github.com/MarioGreks/netrunner-panel/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
